#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [22, 52, 26],
    background_color: "#13140e",
    text_color: "#e5e3d8",
    header_background_color: None,
    modal_background_color: "#202019",
    modal_backdrop: true,
    preview_label_style: (fg: "#c6ca9d"),
    preview_metadata_group_style: (fg: "#c2ce6e", modifiers: "Bold"),
    tab_bar: (
        enabled: true,
        active_style: (fg: "#13140e", bg: "#c2ce6e", modifiers: "Bold"),
        inactive_style: (fg: "#919280"),
    ),
    highlighted_item_style: (fg: "#c6ca9d", modifiers: "Bold"),
    current_item_style: (fg: "#13140e", bg: "#91d69b", modifiers: "Bold"),
    borders_style: (fg: "#474839"),
    highlight_border_style: (fg: "#c2ce6e"),
    symbols: (
        song: "󰝚 ",
        dir: "󰉋 ",
        playlist: "󰲸 ",
        marker: "󰘍  ",
        ellipsis: "…",
        song_style: (fg: "#c6ca9d"),
        dir_style: (fg: "#91d69b"),
        playlist_style: (fg: "#91d69b"),
    ),
    level_styles: (
        info: (fg: "#c6ca9d", bg: "#13140e"),
        warn: (fg: "#c2ce6e", bg: "#13140e"),
        error: (fg: "#ffb4ab", bg: "#13140e"),
        debug: (fg: "#91d69b", bg: "#13140e"),
        trace: (fg: "#c2ce6e", bg: "#13140e"),
    ),
    progress_bar: (
        symbols: ["", "█", "█", "█", "█"],
        track_style: (fg: "#474839"),
        elapsed_style: (fg: "#c2ce6e"),
        thumb_style: (fg: "#c2ce6e", bg: "#474839"),
    ),
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 2,
        bar_spacing: 1,
        bar_color: Gradient({
              0: "#c6ca9d",
             33: "#c2ce6e",
             66: "#91d69b",
            100: "#ffb4ab",
        })
    ),
    scrollbar: (
        symbols: ["│", "█", "⊤", "⊥"],
        track_style: (fg: "#474839"),
        ends_style: (fg: "#919280"),
        thumb_style: (fg: "#c2ce6e"),
    ),
    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                default: (kind: Text("Unknown"), style: (fg: "#919280"))
            ),
            width: "15%",
            alignment: Left,
            style: (fg: "#c6ca9d"),
        ),
        (
            prop: (
                kind: Property(Title),
                default: (kind: Text("Unknown"), style: (fg: "#919280"))
            ),
            width: "40%",
            alignment: Center,
            style: (fg: "#e5e3d8", modifiers: "Bold"),
        ),
        (
            prop: (
                kind: Property(Album),
                default: (kind: Text("Unknown Album"), style: (fg: "#919280"))
            ),
            width: "39%",
            alignment: Center,
            style: (fg: "#c2ce6e"),
        ),
        (
            prop: (
                kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "6%",
            alignment: Right,
            style: (fg: "#919280"),
        ),
    ],
    components: {},
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                borders: "ALL",
                pane: Pane(Header),
            ),
            (
                size: "3",
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                borders: "ALL",
                pane: Pane(TabContent),
            ),
            (
                size: "3",
                borders: "ALL",
                pane: Pane(ProgressBar),
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Text("|"), style: (fg: "#c2ce6e", modifiers: "Bold")),
                    (kind: Property(Status(StateV2(playing_label: "▶ Playing", paused_label: "⏸ Paused", stopped_label: "⏹ Stopped"))), style: (fg: "#91d69b", modifiers: "Bold")),
                    (kind: Text("|"), style: (fg: "#c2ce6e", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#e5e3d8", modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (fg: "#919280", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Status(Bitrate)), style: (fg: "#c6ca9d")),
                    (kind: Text(" kbps"), style: (fg: "#919280")),
                    (kind: Text(" / "), style: (fg: "#474839")),
                    (kind: Property(Widget(ScanStatus)), style: (fg: "#c2ce6e")),
                    (kind: Property(Widget(Volume)), style: (fg: "#91d69b"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#c6ca9d")),
                    (kind: Text(" / "), style: (fg: "#919280")),
                    (kind: Property(Status(Duration)), style: (fg: "#919280")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#c6ca9d", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#919280", modifiers: "Bold"))
                    ),
                    (kind: Text(" — "), style: (fg: "#919280")),
                    (kind: Property(Song(Album)), style: (fg: "#c2ce6e"),
                        default: (kind: Text("Unknown Album"), style: (fg: "#919280"))
                    )
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#91d69b", modifiers: "Bold"),
                            separator_style: (fg: "#474839")))
                        ),
                        style: (fg: "#919280")
                    )
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track), style: (fg: "#919280")),
                (kind: Text("  ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Duration), style: (fg: "#919280")),
                (kind: Text("  ")),
            ])
        ),
        (
            kind: Property(Title), style: (fg: "#e5e3d8", modifiers: "Bold"),
            default: (kind: Property(Filename), style: (fg: "#91d69b"))
        ),
        (
            kind: Group([
                (kind: Text("  ")),
                (kind: Property(Artist), style: (fg: "#c6ca9d")),
            ])
        ),
        (
            kind: Group([
                (kind: Text(" · "), style: (fg: "#919280")),
                (kind: Property(Album), style: (fg: "#c2ce6e")),
            ])
        ),
    ],
    lyrics: (
        timestamp: false
    )
)
