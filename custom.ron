#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: "#181825",
    text_color: "#cdd6f4",
    header_background_color: None,
    modal_background_color: "#1e1e2e",
    modal_backdrop: true,
    preview_label_style: (fg: "#89b4fa"),
    preview_metadata_group_style: (fg: "#cba6f7", modifiers: "Bold"),
    tab_bar: (
        enabled: true,
        active_style: (fg: "#181825", bg: "#cba6f7", modifiers: "Bold"),
        inactive_style: (fg: "#6c7086"),
    ),
    highlighted_item_style: (fg: "#89b4fa", modifiers: "Bold"),
    current_item_style: (fg: "#181825", bg: "#a6e3a1", modifiers: "Bold"),
    borders_style: (fg: "#313244"),
    highlight_border_style: (fg: "#cba6f7"),
    symbols: (
        song: "󰝚 ",
        dir: "󰉋 ",
        playlist: "󰲸 ",
        marker: "󰘍  ",
        ellipsis: "…",
        song_style: (fg: "#89b4fa"),
        dir_style: (fg: "#fab387"),
        playlist_style: (fg: "#a6e3a1"),
    ),
    level_styles: (
        info: (fg: "#89b4fa", bg: "#181825"),
        warn: (fg: "#f9e2af", bg: "#181825"),
        error: (fg: "#f38ba8", bg: "#181825"),
        debug: (fg: "#a6e3a1", bg: "#181825"),
        trace: (fg: "#cba6f7", bg: "#181825"),
    ),
    progress_bar: (
        symbols: ["", "█", "◣", "█", "█"],
        track_style: (fg: "#313244"),
        elapsed_style: (fg: "#cba6f7"),
        thumb_style: (fg: "#cba6f7", bg: "#313244"),
    ),
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 2,
        bar_spacing: 1,
        bar_color: Gradient({
              0: "#89b4fa",
             33: "#cba6f7",
             66: "#f5c2e7",
            100: "#f38ba8",
        })
    ),
    scrollbar: (
        symbols: ["│", "█", "⊤", "⊥"],
        track_style: (fg: "#313244"),
        ends_style: (fg: "#6c7086"),
        thumb_style: (fg: "#cba6f7"),
    ),
    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                default: (kind: Text("Unknown"), style: (fg: "#6c7086"))
            ),
            width: "25%",
            style: (fg: "#89b4fa"),
        ),
        (
            prop: (
                kind: Property(Title),
                default: (kind: Text("Unknown"), style: (fg: "#6c7086"))
            ),
            width: "30%",
            alignment: Center,
            style: (fg: "#cdd6f4", modifiers: "Bold"),
        ),
        (
            prop: (
                kind: Property(Album),
                default: (kind: Text("Unknown Album"), style: (fg: "#6c7086"))
            ),
            width: "25%",
            alignment: Center,
            style: (fg: "#cba6f7"),
        ),
        (
            prop: (
                kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "20%",
            alignment: Right,
            style: (fg: "#6c7086"),
        ),
    ],
    components: {},
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                borders: "ALL",
                pane: Pane(Header),
            ),
            (
                size: "3",
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                borders: "ALL",
                pane: Pane(TabContent),
            ),
            (
                size: "3",
                borders: "ALL",
                pane: Pane(ProgressBar),
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Text("|"), style: (fg: "#cba6f7", modifiers: "Bold")),
                    (kind: Property(Status(StateV2(playing_label: "▶ Playing", paused_label: "⏸ Paused", stopped_label: "⏹ Stopped"))), style: (fg: "#a6e3a1", modifiers: "Bold")),
                    (kind: Text("|"), style: (fg: "#cba6f7", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#cdd6f4", modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (fg: "#6c7086", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Status(Bitrate)), style: (fg: "#94e2d5")),
                    (kind: Text(" kbps"), style: (fg: "#6c7086")),
                    (kind: Text(" / "), style: (fg: "#313244")),
                    (kind: Property(Widget(ScanStatus)), style: (fg: "#f9e2af")),
                    (kind: Property(Widget(Volume)), style: (fg: "#fab387"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#94e2d5")),
                    (kind: Text(" / "), style: (fg: "#6c7086")),
                    (kind: Property(Status(Duration)), style: (fg: "#6c7086")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#89b4fa", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#6c7086", modifiers: "Bold"))
                    ),
                    (kind: Text(" — "), style: (fg: "#6c7086")),
                    (kind: Property(Song(Album)), style: (fg: "#cba6f7"),
                        default: (kind: Text("Unknown Album"), style: (fg: "#6c7086"))
                    )
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#f5c2e7", modifiers: "Bold"),
                            separator_style: (fg: "#313244")))
                        ),
                        style: (fg: "#6c7086")
                    )
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track), style: (fg: "#6c7086")),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "#89b4fa")),
                (kind: Text(" - "), style: (fg: "#6c7086")),
                (kind: Property(Title), style: (fg: "#cdd6f4")),
            ]),
            default: (kind: Property(Filename), style: (fg: "#fab387"))
        ),
    ],
    lyrics: (
        timestamp: false
    )
)
