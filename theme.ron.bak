#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " · ",
    browser_column_widths: [20, 38, 42],
    background_color: "#0d1117",
    text_color: "#cdd6f4",
    header_background_color: "#0d1117",
    modal_background_color: "#161b22",
    modal_backdrop: true,
    preview_label_style: (fg: "#2dd4bf"),
    preview_metadata_group_style: (fg: "#2dd4bf", modifiers: "Bold"),
    highlighted_item_style: (fg: "#2dd4bf", modifiers: "Bold"),
    current_item_style: (fg: "#0d1117", bg: "#2dd4bf", modifiers: "Bold"),
    borders_style: (fg: "#1e2a38"),
    highlight_border_style: (fg: "#2dd4bf"),
    symbols: (
        song: "♪",
        dir: "▸",
        playlist: "·",
        marker: "●",
        ellipsis: "…",
        song_style: (fg: "#2dd4bf"),
        dir_style: (fg: "#f472b6"),
        playlist_style: (fg: "#cdd6f4", modifiers: "Dim"),
    ),
    level_styles: (
        info: (fg: "#2dd4bf", bg: "#0d1117"),
        warn: (fg: "#f472b6", bg: "#0d1117"),
        error: (fg: "#f87171", bg: "#0d1117"),
        debug: (fg: "#a3e635", bg: "#0d1117"),
        trace: (fg: "#c084fc", bg: "#0d1117"),
    ),
    progress_bar: (
        symbols: ["─", "─", "●", "─", "─"],
        track_style: (fg: "#1e2a38"),
        elapsed_style: (fg: "#2dd4bf"),
        thumb_style: (fg: "#f472b6"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#1e2a38"),
        ends_style: (fg: "#1e2a38"),
        thumb_style: (fg: "#2dd4bf"),
    ),
    tab_bar: (
        active_style: (fg: "#0d1117", bg: "#2dd4bf", modifiers: "Bold"),
        inactive_style: (fg: "#4a5568"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "#f472b6")),
                (kind: Text(" · "), style: (fg: "#4a5568")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                style: (fg: "#f472b6"),
                default: (kind: Text("Unknown"), style: (fg: "#4a5568"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album),
                style: (fg: "#2dd4bf"),
                default: (kind: Text("Unknown Album"), style: (fg: "#4a5568"))
            ),
            label_prop: (kind: Text("Album")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration),
                style: (fg: "#4a5568"),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Duration")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs · ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" "))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Property(Status(StateV2())), style: (fg: "#2dd4bf", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("· nothing playing ·"), style: (modifiers: "Bold", fg: "#4a5568"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text("·"))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#2dd4bf"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#4a5568"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#2dd4bf")),
                (kind: Text(" · "), style: (fg: "#4a5568")),
                (kind: Property(Status(Duration))),
                (kind: Group([
                    (kind: Text(" · ")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps")),
                ]), style: (fg: "#4a5568")),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#f472b6", modifiers: "Bold"),
                    default: (kind: Text("unknown"), style: (fg: "#4a5568"))),
                (kind: Text(" · "), style: (fg: "#4a5568")),
                (kind: Property(Song(Album)), style: (fg: "#2dd4bf"),
                    default: (kind: Text("unknown album"), style: (fg: "#4a5568"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#2dd4bf"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#f472b6", modifiers: "Bold"),
                            off_style: (fg: "#1e2a38"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#f472b6", modifiers: "Bold"),
                            off_style: (fg: "#1e2a38"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#f472b6", modifiers: "Bold"),
                            off_style: (fg: "#1e2a38"),
                            oneshot_style: (fg: "#2dd4bf"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#f472b6", modifiers: "Bold"),
                            off_style: (fg: "#1e2a38"),
                            oneshot_style: (fg: "#2dd4bf"),
                        )))),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#0d1117", bg: "#2dd4bf"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#0d1117", bg: "#f472b6"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
