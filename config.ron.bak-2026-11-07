
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    theme:"custom",
    cache_dir: "~/.cache/rmpc",
    lyrics_dir: Some("/home/user/Music/Lyrics"),
    on_song_change: Some(["python3", "/home/user/.config/rmpc/scripts/notify_lyrics.py"]),
    volume_step: 5,
    max_fps: 60,
    scrolloff: 0,
    wrap_navigation: false,
    enable_mouse: true,
    enable_config_hot_reload: true,
    status_update_interval_ms: 1000,
    rewind_to_start_sec: None,
    reflect_changes_to_playlist: false,
    select_current_song_on_change: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    directories_sort: SortFormat(group_by_type: true, reverse: false),
    cava: (
        framerate: 60, // default 60
        autosens: true, // default true
        sensitivity: 100, // default 100
        lower_cutoff_freq: 50, // not passed to cava if not provided
        higher_cutoff_freq: 10000, // not passed to cava if not provided
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 50, // default 77
            monstercat: false, // default false
            waves: false, // default false
        ),
        // this is a list of floating point numbers thats directly passed to cava
        // they are passed in order that they are defined
        eq: []
    ),
    keybinds: (
        global: {
            ":":       CommandMode,
            "-":       VolumeDown,
            "<C-p>":       Stop,
            "+":       VolumeUp,
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "1":       SwitchToTab("Queue"),
            "2":       SwitchToTab("Playlists"),
            "3":       SwitchToTab("Artists"),
            "4":       SwitchToTab("Albums"),
            "5":       SwitchToTab("Search"),
            "6":       SwitchToTab("Lyrics"),
            "q":       Quit,
            ">":       NextTrack,
            "p":       TogglePause,
            "<":       PreviousTrack,
            "f":       SeekForward,
            "z":       ToggleRepeat,
            "x":       ToggleRandom,
            "c":       ToggleConsume,
            "v":       ToggleSingle,
            "b":       SeekBack,
            "~":       ShowHelp,
            "u":       Update,
            "U":       Rescan,
            "I":       ShowCurrentSongInfo,
            "O":       ShowOutputs,
            "P":       ShowDecoders,
            "R":       AddRandom,
        },
        navigation: {
            "k":         Up,
            "j":         Down,
            "h":         Left,
            "l":         Right,
            "<Up>":      Up,
            "<Down>":    Down,
            "<Left>":    Left,
            "<Right>":   Right,
            "<C-k>":     PaneUp,
            "<C-j>":     PaneDown,
            "<C-h>":     PaneLeft,
            "<C-l>":     PaneRight,
            "<C-u>":     UpHalf, 
            "<C-Up>":     PaneUp,
            "<C-Down>":     PaneDown,
            "<C-Left>":     PaneLeft,
            "<C-Right>":     PaneRight,
            "N":         PreviousResult,
            "a":         Add,
            "A":         AddAll,
            "r":         Rename,
            "n":         NextResult,
            "g":         Top,
            "<Space>":   Select,
            "<C-Space>": InvertSelection,
            "G":         Bottom,
            "<CR>":      Confirm,
            "i":         FocusInput,
            "J":         MoveDown,
            "<C-d>":     DownHalf,
            "/":         EnterSearch,
            "<C-c>":     Close,
            "<Esc>":     Close,
            "K":         MoveUp,
            "D":         Delete,
            "B":         ShowInfo,
        },
        queue: {
            "D":       DeleteAll,
            "<CR>":    Play,
            "<C-s>":   Save,
            "a":       AddToPlaylist,
            "d":       Delete,
            "C":       JumpToCurrent,
        },
    ),
    search: (
        case_sensitive: false,
        mode: Contains,
        tags: [
        (value: "any",         label: "Any Tag"),
        (value: "artist",      label: "Artist"),
        (value: "album",       label: "Album"),
        (value: "albumartist", label: "Album Artist"),
        (value: "title",       label: "Title"),
        (value: "filename",    label: "Filename"),
        (value: "genre",       label: "Genre"),
        ],
    ),
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
    ),
    album_art: (
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Top,
        horizontal_align: Center,
    ),

    tabs: [
    (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                (
                        size: "68%",
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                            (
                                    size: "60%",
                                    borders: "ALL",
                                    border_symbols: Plain,
                                    border_title: [(kind: Text(" Queue "))],
                                    border_title_alignment: Center,
                                    pane: Pane(Queue),
                                ),
                            (
                                    size: "40%",
                                    borders: "ALL",
                                    border_symbols: Plain,
                                    border_title: [(kind: Text(" Lyrics "))],
                                    border_title_alignment: Center,
                                    pane: Pane(Lyrics),
                                ),
                            ],
                        ),
                    ),
                (
                        size: "32%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                            (
                                    size: "88%",
                                    borders: "LEFT | RIGHT | TOP",
                                    border_symbols: Plain,
                                    border_title: [(kind: Text(" Album Art "))],
                                    border_title_alignment: Center,
                                    pane: Pane(AlbumArt),
                                ),
                            (
                                    size: "12%",
                                    borders: "LEFT | RIGHT | BOTTOM",
                                    border_symbols: Plain,
                                    pane: Pane(Cava),
                                ),
                            ],
                        ),
                    ),
                ],
            ),
        ),

    (
            name: "Playlists",
            pane: Split(
                direction: Vertical,
                panes: [
                (
                        size: "100%",
                        pane: Pane(Playlists),
                    ),
                ],
            ),
        ),

    (
            name: "Artists",
            pane: Split(
                direction: Vertical,
                panes: [
                (
                        size: "100%",
                        pane: Pane(Artists),
                    ),
                ],
            ),
        ),

    (
            name: "Albums",
            pane: Split(
                direction: Vertical,
                panes: [
                (
                        size: "100%",
                        pane: Pane(Albums),
                    ),
                ],
            ),
        ),

    (
            name: "Search",
            pane: Split(
                direction: Vertical,
                panes: [
                (
                        size: "100%",
                        pane: Pane(Search),
                    ),
                ],
            ),
        ),
    ],
)
